# --- Azure AD app registration (portal.azure.com → Microsoft Entra ID → App registrations) ---

# Directory (tenant) ID of your app registration.
# For personal Microsoft accounts use "consumers" (or "common").
AZURE_TENANT_ID=

# Application (client) ID of the app registration.
AZURE_CLIENT_ID=

# --- Outlook ---

# Mailbox to read from and send as (the account you sign in with during `npm run auth`).
OUTLOOK_USER_EMAIL=

# Display name of the Outlook folder your inbox rule moves RFQ mail into.
OUTLOOK_WATCHED_FOLDER=Decode Demo Inbox

# Where result/error replies are sent — normally your quoting team's mailbox.
# The reports include internal pricing, cost, and margin data, so they are
# typically NOT for the RFQ sender. Set to the literal value "sender" to reply
# to the original sender instead (e.g. for an internal-only intake address).
OUTLOOK_REPLY_TO=

# Optional: blind-copy every outgoing reply to this address.
#OUTLOOK_REPLY_BCC=

# --- Boardera Decode API ---

# Your Decode API key from https://boardera.io/register — the full base64
# string shown in your Boardera console.
DECODE_API_KEY=

# Optional: override the API endpoint (defaults to production).
#DECODE_API_ENDPOINT=https://api.boardera.io/api/v1

# --- Tuning (optional) ---

# Quantity used when the email doesn't specify one.
#DEFAULT_QUANTITY=10

# Polling interval for `npm start`, in milliseconds.
#POLL_INTERVAL_MS=30000

# Max per-violation image tiles in the DFM report; 0 disables tiles.
#DFM_IMAGE_LIMIT=20
