{
  "name": "decode-email-rfq-triage",
  "version": "1.0.0",
  "private": true,
  "description": "Demo: receive a circuit board design package by email, run it through the Boardera Decode API, and reply with an Executive Summary PDF, BOM Excel, and DFM report.",
