  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth": "tsx src/index.ts auth",
    "run-once": "tsx src/index.ts run-once",
    "start": "tsx src/index.ts start",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
